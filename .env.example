# Copy this file to `.env` for local testing (never commit `.env` — it's
# gitignored). In GitHub Actions these are set as encrypted repo secrets
# instead (Settings > Secrets and variables > Actions > New repository
# secret) and injected as env vars by .github/workflows/price-check.yml —
# nothing reads a real .env file in CI.

EUROLOTS_USERNAME=
EUROLOTS_PASSWORD=

MERKANDI_USERNAME=
MERKANDI_PASSWORD=

# Any SMTP provider works, so there's no signup cost:
#   Gmail:            smtp.gmail.com, port 587 (requires a Google "app
#                      password", not your normal login password)
#   Outlook/Office365: smtp.office365.com, port 587
#   A free-tier transactional service (SendGrid, Mailgun, etc.) also
#   exposes SMTP credentials if you'd rather use one of those.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Where price alerts get sent. Defaults to faheem_islam02@hotmail.com
# (in config.py) if left unset.
ALERT_EMAIL_TO=faheem_islam02@hotmail.com
